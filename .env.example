# .env.example — modello delle variabili d'ambiente di Pannello Tempo.
#
# Copia questo file in `.env` e compilalo con i valori del TUO progetto.
# `.env` è escluso da git (vedi .gitignore): non deve entrare nel
# repository, nemmeno contenendo solo valori pubblici.
#
# ─────────────────────────────────────────────────────────────────────────
# QUI NON VANNO SEGRETI.
# ─────────────────────────────────────────────────────────────────────────
#
# Tutti i valori qui sotto sono la configurazione PUBBLICA di una web app
# Firebase: identificano il progetto, non autorizzano niente. Google li
# pubblica nei propri esempi. Ciò che protegge i dati sono Firebase
# Authentication, le Security Rules (firebase/firestore.rules) e App Check.
#
# NON aggiungere qui, e non passare al generatore:
#   - service account o chiavi private
#   - client secret OAuth
#   - password
#   - token personali di qualunque servizio
#
# Il generatore si INTERROMPE se trova variabili PT_* il cui nome contiene
# SECRET, PRIVATE_KEY, SERVICE_ACCOUNT, CLIENT_SECRET, PASSWORD o TOKEN.
# Non è paranoia: il modo più comune di pubblicare una chiave privata è
# passarla a uno script che si aspettava una chiave pubblica.

# ─── Progetto Firebase ───────────────────────────────────────────────────
# Console Firebase → ⚙ Impostazioni progetto → Generali → Le tue app → Web

PT_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PT_FIREBASE_AUTH_DOMAIN=NOME-PROGETTO.firebaseapp.com
PT_FIREBASE_PROJECT_ID=NOME-PROGETTO
PT_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ─── App Check ───────────────────────────────────────────────────────────
# Chiave PUBBLICA del sito reCAPTCHA Enterprise (o v3).
# Vuota = App Check non attivo: la sincronizzazione funziona ma senza
# protezione dall'abuso. Il pannello lo dichiara nella schermata
# Informazioni invece di far finta che sia attivo.

PT_APPCHECK_SITE_KEY=

# Debug token di App Check: SOLO in sviluppo, MAI in produzione.
# Il generatore si interrompe se lo trova valorizzato con
# --ambiente produzione.

# PT_APPCHECK_DEBUG_TOKEN=

# ─── Emulatore (solo ambiente «emulatore») ───────────────────────────────

PT_EMULATORE_AUTH=http://127.0.0.1:9099
PT_EMULATORE_FIRESTORE=http://127.0.0.1:8080

# ─── Progetto usato dai collaudi ─────────────────────────────────────────
# Deve essere un progetto FINTO. `demo-` è il prefisso che l'emulatore
# Firebase riconosce come progetto dimostrativo: non tocca nulla di reale
# e non richiede credenziali.

PT_PROGETTO_TEST=demo-pannello
